#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["mellea", "codespell"]
# ///
"""Generate a git branch slug from a GitHub issue number.

Usage: issue-slug <issue-number>
Outputs a 3-4 word kebab-case slug to stdout, or exits non-zero on failure.
"""

import logging
import os
import re
import subprocess
import sys
import tempfile

from mellea import start_session
from mellea.core.utils import MelleaLogger
from mellea.stdlib.requirements import Requirement, simple_validate
from mellea.stdlib.sampling import RejectionSamplingStrategy

# Silence mellea's INFO log chatter so stdout is just the slug.
MelleaLogger.get_logger().setLevel(logging.WARNING)

# Strict: drives the model — aim for 3-4 words.
STRICT_SLUG_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+){2,3}$")
# Loose: post-retry acceptance — 2-5 words are fine if the model couldn't hit 3-4.
LOOSE_SLUG_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+){1,4}$")


def is_strict_slug(s: str) -> bool:
    return bool(STRICT_SLUG_RE.fullmatch(s.strip()))


def is_loose_slug(s: str) -> bool:
    return bool(LOOSE_SLUG_RE.fullmatch(s.strip()))


def fetch_title(issue: str) -> str:
    result = subprocess.run(
        ["gh", "issue", "view", issue, "--json", "title", "--jq", ".title"],
        capture_output=True,
        text=True,
        check=True,
    )
    return result.stdout.strip()


def spelled_correctly(slug: str) -> bool:
    """True if codespell finds no typos in `slug` (best-effort; True if unavailable).

    codespell detects a misspelling even inside a hyphenated token, so the whole slug
    is checked at once; it exits non-zero when it finds one. Used both as a sampling
    requirement and as a final gate.
    """
    with tempfile.NamedTemporaryFile("w+", suffix=".txt", delete=False) as f:
        f.write(slug + "\n")
        path = f.name
    try:
        result = subprocess.run(
            ["codespell", path], capture_output=True, text=True, check=False
        )
        return result.returncode == 0
    except OSError:
        return True  # codespell unavailable -> don't block slug generation
    finally:
        os.unlink(path)


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: issue-slug <issue-number>", file=sys.stderr)
        return 2

    title = fetch_title(sys.argv[1])

    m = start_session()

    prompt = (
        "Convert this GitHub issue title into a git branch slug.\n\n"
        f"Title: {title}\n\n"
        "Rules:\n"
        "- Output exactly 3 or 4 words separated by hyphens\n"
        "- Lowercase letters and numbers only\n"
        "- DROP conventional commit prefixes like 'feat:', 'fix:', 'refactor:', 'docs:', 'test:', 'chore:' "
        "and their scoped forms like 'fix(hf):'\n"
        "- Pick the most distinguishing technical words, not necessarily the first ones\n"
        "- Output only the slug, nothing else\n\n"
        "Examples:\n"
        "  'refactor: move generate_from_raw hook into Backend base' -> 'raw-hook-base-class'\n"
        "  'fix(hf): null pointer in telemetry init' -> 'telemetry-null-pointer'\n"
        "  'feat: add OpenAI structured output support' -> 'openai-structured-output'\n\n"
        "Slug:"
    )

    result = m.instruct(
        prompt,
        requirements=[
            Requirement(
                "Output is exactly 3-4 lowercase kebab-case words.",
                validation_fn=simple_validate(is_strict_slug),
            ),
            Requirement(
                "Every word in the slug is spelled correctly.",
                validation_fn=simple_validate(spelled_correctly),
            ),
        ],
        strategy=RejectionSamplingStrategy(loop_budget=3),
    )

    slug = str(result).strip().strip("'\"`")
    # Defensive: normalize stray separators ('.', '_', whitespace) to '-'.
    slug = re.sub(r"[._\s]+", "-", slug).strip("-")

    # Last-ditch: if the model produced 6+ words but the prefix is well-formed,
    # truncate to 5 rather than fall through to the awk fallback in the caller.
    if not is_loose_slug(slug):
        parts = slug.split("-")
        if len(parts) > 5 and all(re.fullmatch(r"[a-z0-9]+", p) for p in parts[:5]):
            slug = "-".join(parts[:5])

    if not is_loose_slug(slug):
        print(f"validation failed: {slug!r}", file=sys.stderr)
        return 1

    # Spelling is a hard gate too: a typo'd slug would just block the first commit at
    # codespell, so fail loudly here rather than emit it.
    if not spelled_correctly(slug):
        print(f"validation failed (spelling): {slug!r}", file=sys.stderr)
        return 1

    quality = "strict" if is_strict_slug(slug) else "loose"
    print(f"slug quality: {quality}", file=sys.stderr)
    print(slug)
    return 0


if __name__ == "__main__":
    sys.exit(main())
